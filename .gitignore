# Build output
/target
dist/

# Tauri writes the capability schemas at each build.
**/gen/schemas/

# Editor frontend dependencies.
node_modules/

# Machine-specific agent rules.
/AGENTS.local.md

# The toolchain and the user projects of a portable Patina folder (spec 13.3).
/toolchain/
/projects/

# Reports and other files that agents and tools make.
/artifacts/

# The build folder of the example projects (spec 6.2).
/examples/*/build/

# The incremental build state of the TypeScript compiler.
*.tsbuildinfo
